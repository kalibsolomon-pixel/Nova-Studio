; SPDX-License-Identifier: GPL-3.0-or-later
; Nova Studio per-user installer (Phase 4-G). Generated by CPack from packaging/nsis/NSIS.template.in.
;
; Decisions (docs/phase-4g/NSIS_INSTALLER_VALIDATION.md):
;   * Per-user into %LOCALAPPDATA%\Programs\Nova Studio. Never elevated. HKCU only.
;   * The installer only ever writes into its own installation folder, one Start menu shortcut
;     and its own uninstall registry key. It never touches projects, settings, recovery data,
;     the Minecraft test runtime (all under %LOCALAPPDATA%\Nova Studio) or AI agent settings.
;   * A folder is used only if it is empty, missing, or already holds this installer's marker.
;     The Phase 3-E Inno Setup copy and unrelated folders are refused, never overwritten.
;   * The marker and uninstaller are written before any program file, so an interrupted
;     installation can be repaired by running the installer again, or removed.
;   * Upgrade and reinstall run the installed copy's own uninstaller first. It deletes only the
;     files its version installed, then the new files are copied.
;   * Running copies of nova-studio.exe or nova-mcp.exe in the folder stop the installation.
;   * Uninstall deletes only the files listed below and folders left empty, never recursively.

!define INST_DIR "@CPACK_TEMPORARY_DIRECTORY@"
!define APP_NAME "Nova Studio"
!define APP_EXE "nova-studio.exe"
!define BRIDGE_EXE "nova-mcp.exe"
!define UNINSTALLER "@CPACK_NSIS_UNINSTALL_NAME@.exe"
!define MARKER "nova-studio-install.txt"
!define PRODUCT_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\NovaStudio"
!define SHORTCUT "$SMPROGRAMS\${APP_NAME}.lnk"
!define VERSION "@CPACK_PACKAGE_VERSION@"
!define REVISION "@CPACK_NOVA_REVISION@"

Unicode true
ManifestDPIAware true
ManifestSupportedOS Win10
RequestExecutionLevel user
SetCompressor @CPACK_NSIS_COMPRESSOR@
Name "${APP_NAME} ${VERSION}"
Caption "${APP_NAME} ${VERSION} Setup"
UninstallCaption "Uninstall ${APP_NAME} ${VERSION}"
BrandingText "${APP_NAME} ${VERSION} · preview"
OutFile "@CPACK_TOPLEVEL_DIRECTORY@/@CPACK_OUTPUT_FILE_NAME@"
InstallDir "$LOCALAPPDATA\Programs\${APP_NAME}"
InstallDirRegKey HKCU "${PRODUCT_KEY}" "InstallLocation"
ShowInstDetails show
ShowUninstDetails show

VIProductVersion "@CPACK_NOVA_VERSION_QUAD@"
VIFileVersion "@CPACK_NOVA_VERSION_QUAD@"
VIAddVersionKey "ProductName" "${APP_NAME}"
VIAddVersionKey "ProductVersion" "${VERSION}"
VIAddVersionKey "FileVersion" "${VERSION}"
VIAddVersionKey "CompanyName" "@CPACK_PACKAGE_VENDOR@"
VIAddVersionKey "FileDescription" "${APP_NAME} ${VERSION} per-user installer"
VIAddVersionKey "Comments" "Source ${REVISION}. Preview release."
VIAddVersionKey "LegalCopyright" "@CPACK_NOVA_COPYRIGHT@. Licensed under @CPACK_NOVA_LICENSE@."

!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "x64.nsh"
!include "WinVer.nsh"
!include "FileFunc.nsh"

!define MUI_ICON "@CPACK_NSIS_MUI_ICON@"
!define MUI_UNICON "@CPACK_NSIS_MUI_UNIICON@"
!define MUI_ABORTWARNING
!define MUI_WELCOMEPAGE_TITLE "Install ${APP_NAME} ${VERSION}"
!define MUI_WELCOMEPAGE_TEXT "This is a preview release of ${APP_NAME}, a resource-pack editor for Minecraft Java Edition. ${APP_NAME} is free software under the GNU General Public License version 3 or later.$\r$\n$\r$\nIt installs for your Windows account only and does not need administrator rights. Your resource packs, settings and recovery data are never changed by Setup.$\r$\n$\r$\nThis installer is not code-signed, so Windows may ask you to confirm that you want to run it."
!insertmacro MUI_PAGE_WELCOME
; GPL-3.0 section 9: the license need not be accepted to install or run the program, so this page
; only informs (a Next button, no "I agree"). Phase 4-H.2: the same page presents the end-user terms
; for the Microsoft Visual C++ runtime files (Distributable Code), which installing them accepts;
; no extra prompt. Silent installs skip the page; the terms are also installed under licenses\.
!define MUI_LICENSEPAGE_TEXT_TOP "Nova Studio is free software, licensed under the GNU General Public License version 3 or later."
!define MUI_LICENSEPAGE_TEXT_BOTTOM "You do not have to accept the GPL to install Nova Studio. The Microsoft Visual C++ runtime terms at the end of the text apply to the Microsoft files: by choosing Next and installing, you agree to them."
!define MUI_LICENSEPAGE_BUTTON "$(^NextBtn)"
!insertmacro MUI_PAGE_LICENSE "@CPACK_RESOURCE_FILE_LICENSE@"
!define MUI_PAGE_CUSTOMFUNCTION_LEAVE DirectoryLeave
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$INSTDIR\${APP_EXE}"
!define MUI_FINISHPAGE_RUN_TEXT "Start ${APP_NAME}"
!define MUI_FINISHPAGE_SHOWREADME "$INSTDIR\README.txt"
!define MUI_FINISHPAGE_SHOWREADME_TEXT "Show the README"
!define MUI_FINISHPAGE_SHOWREADME_NOTCHECKED
!insertmacro MUI_PAGE_FINISH
!define MUI_UNCONFIRMPAGE_TEXT_TOP "${APP_NAME} will be removed from the folder below. Your resource packs, settings, recovery snapshots and the Minecraft test runtime are kept.$\r$\n$\r$\nAI agents you set up for Nova Studio keep their entry for nova-mcp.exe. Remove the $\"nova-studio$\" server from their settings, or they will report that it failed to start."
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Var Problem

; ---------------------------------------------------------------- shared checks
!macro RunningCheck un
Function ${un}RunningCheck
  ; A running image cannot be opened for writing. Also covers nova-mcp.exe started by an AI agent.
  ${Do}
    StrCpy $Problem ""
    ${If} ${FileExists} "$INSTDIR\${APP_EXE}"
      ClearErrors
      FileOpen $0 "$INSTDIR\${APP_EXE}" a
      ${If} ${Errors}
        StrCpy $Problem "${APP_NAME} is running from this folder."
      ${Else}
        FileClose $0
      ${EndIf}
    ${EndIf}
    ${If} $Problem == ""
    ${AndIf} ${FileExists} "$INSTDIR\${BRIDGE_EXE}"
      ClearErrors
      FileOpen $0 "$INSTDIR\${BRIDGE_EXE}" a
      ${If} ${Errors}
        StrCpy $Problem "An AI agent is using the Nova Studio MCP bridge (nova-mcp.exe)."
      ${Else}
        FileClose $0
      ${EndIf}
    ${EndIf}
    ${If} $Problem == ""
      ${Break}
    ${EndIf}
    MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "$Problem$\r$\n$\r$\nClose ${APP_NAME} and any AI agent connected to it, then choose Retry." /SD IDCANCEL IDRETRY retry
    SetErrorLevel 5
    Quit
    retry:
  ${Loop}
FunctionEnd
!macroend
!insertmacro RunningCheck ""
!insertmacro RunningCheck "un."

; Returns in $Problem why $INSTDIR cannot be used, or "".
Function CheckTarget
  StrCpy $Problem ""
  ; The longest installed file adds about 90 characters; Windows paths stop at 260.
  StrLen $0 $INSTDIR
  ${If} $0 > 160
    StrCpy $Problem "Choose a folder with a shorter path (160 characters or fewer). Some ${APP_NAME} files have long names."
    Return
  ${EndIf}
  ; One installation per Windows user: a second folder would orphan the first.
  ReadRegStr $0 HKCU "${PRODUCT_KEY}" "InstallLocation"
  ${If} $0 != ""
  ${AndIf} $0 != $INSTDIR
  ${AndIf} ${FileExists} "$0\${MARKER}"
    StrCpy $Problem "${APP_NAME} is already installed in $0. Install to that folder to upgrade it, or uninstall it first."
    Return
  ${EndIf}
  ${If} ${FileExists} "$INSTDIR\unins000.exe"
    StrCpy $Problem "This folder holds ${APP_NAME} installed by an earlier installer. Uninstall it from Settings > Apps first, or choose another folder."
    Return
  ${EndIf}
  ${If} ${FileExists} "$INSTDIR\${MARKER}"
    Return ; this installer's own folder: upgrade or repair
  ${EndIf}
  ${If} ${FileExists} "$INSTDIR\*.*"
    FindFirst $0 $1 "$INSTDIR\*.*"
    ${DoWhile} $1 != ""
      ${If} $1 != "."
      ${AndIf} $1 != ".."
        StrCpy $Problem "The folder $INSTDIR is not empty. Choose an empty or new folder so Setup never mixes ${APP_NAME} with other files."
        ${Break}
      ${EndIf}
      FindNext $0 $1
    ${Loop}
    FindClose $0
  ${EndIf}
FunctionEnd

Function .onInit
  SetShellVarContext current
  SetRegView 64
  ${IfNot} ${RunningX64}
    MessageBox MB_OK|MB_ICONSTOP "${APP_NAME} requires 64-bit Windows." /SD IDOK
    SetErrorLevel 3
    Quit
  ${EndIf}
  ${IfNot} ${AtLeastWin10}
    MessageBox MB_OK|MB_ICONSTOP "${APP_NAME} requires Windows 11." /SD IDOK
    SetErrorLevel 3
    Quit
  ${EndIf}
  ${IfNot} ${AtLeastBuild} 22000
    MessageBox MB_YESNO|MB_ICONEXCLAMATION "${APP_NAME} is tested on Windows 11 only. It may not work on this version of Windows. Continue anyway?" /SD IDNO IDYES +3
    SetErrorLevel 3
    Quit
  ${EndIf}
FunctionEnd

Function DirectoryLeave
  Call CheckTarget
  ${If} $Problem != ""
    MessageBox MB_OK|MB_ICONEXCLAMATION "$Problem"
    Abort
  ${EndIf}
FunctionEnd

; ---------------------------------------------------------------- install
Section "-Install"
  SetShellVarContext current
  SetRegView 64
  Call CheckTarget
  ${If} $Problem != ""
    MessageBox MB_OK|MB_ICONSTOP "$Problem" /SD IDOK
    SetErrorLevel 4
    Quit
  ${EndIf}
  Call RunningCheck
  ; Upgrade or repair: the installed copy's own uninstaller removes exactly its own files.
  ${If} ${FileExists} "$INSTDIR\${MARKER}"
  ${AndIf} ${FileExists} "$INSTDIR\${UNINSTALLER}"
    StrCpy $2 0
    FindFirst $0 $1 "$INSTDIR\*.*"
    ${DoWhile} $1 != ""
      ${If} $1 != "."
      ${AndIf} $1 != ".."
      ${AndIf} $1 != "${MARKER}"
      ${AndIf} $1 != "${UNINSTALLER}"
        StrCpy $2 1
      ${EndIf}
      FindNext $0 $1
    ${Loop}
    FindClose $0
    ${If} $2 == 1
    DetailPrint "Removing the files of the installed version"
    InitPluginsDir
    CopyFiles /SILENT "$INSTDIR\${UNINSTALLER}" "$PLUGINSDIR\previous-uninstaller.exe"
    ExecWait '"$PLUGINSDIR\previous-uninstaller.exe" /S /UPGRADE _?=$INSTDIR' $0
    ${If} $0 != 0
      MessageBox MB_OK|MB_ICONSTOP "The installed version could not be removed (code $0). Nothing else was changed." /SD IDOK
      SetErrorLevel 6
      Quit
    ${EndIf}
    ${EndIf}
  ${EndIf}
  ; Marker, uninstaller and registration first: an interrupted copy stays repairable.
  CreateDirectory "$INSTDIR"
  SetOutPath "$INSTDIR"
  FileOpen $0 "$INSTDIR\${MARKER}" w
  FileWrite $0 "${APP_NAME} ${VERSION} (source ${REVISION})$\r$\nThis folder is managed by the ${APP_NAME} installer. Do not store other files here.$\r$\n"
  FileClose $0
  WriteUninstaller "$INSTDIR\${UNINSTALLER}"
  WriteRegStr HKCU "${PRODUCT_KEY}" "DisplayName" "${APP_NAME} (preview)"
  WriteRegStr HKCU "${PRODUCT_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "${PRODUCT_KEY}" "Publisher" "@CPACK_PACKAGE_VENDOR@"
  WriteRegStr HKCU "${PRODUCT_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${PRODUCT_KEY}" "DisplayIcon" "$INSTDIR\${APP_EXE}"
  WriteRegStr HKCU "${PRODUCT_KEY}" "UninstallString" '"$INSTDIR\${UNINSTALLER}"'
  WriteRegStr HKCU "${PRODUCT_KEY}" "QuietUninstallString" '"$INSTDIR\${UNINSTALLER}" /S'
  WriteRegStr HKCU "${PRODUCT_KEY}" "Comments" "Source ${REVISION}"
  WriteRegDWORD HKCU "${PRODUCT_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${PRODUCT_KEY}" "NoRepair" 1
  @CPACK_NSIS_FULL_INSTALL@
  SetOutPath "$INSTDIR"
  CreateShortcut "${SHORTCUT}" "$INSTDIR\${APP_EXE}" "" "$INSTDIR\${APP_EXE}" 0 SW_SHOWNORMAL "" "${APP_NAME} resource-pack editor"
  WriteRegStr HKCU "${PRODUCT_KEY}" "StartMenuShortcut" "${SHORTCUT}"
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD HKCU "${PRODUCT_KEY}" "EstimatedSize" "$0"
  DetailPrint "Installed ${APP_NAME} ${VERSION} in $INSTDIR"
SectionEnd

; ---------------------------------------------------------------- uninstall
Function un.onInit
  SetShellVarContext current
  SetRegView 64
  ; Only ever operate on a folder this installer created.
  ${IfNot} ${FileExists} "$INSTDIR\${MARKER}"
    MessageBox MB_OK|MB_ICONSTOP "$INSTDIR does not contain a ${APP_NAME} installation. Nothing was removed." /SD IDOK
    SetErrorLevel 4
    Quit
  ${EndIf}
FunctionEnd

Section "Uninstall"
  Call un.RunningCheck
@CPACK_NSIS_DELETE_FILES@
  Delete "$INSTDIR\${UNINSTALLER}"
  Delete "$INSTDIR\${MARKER}"
@CPACK_NSIS_DELETE_DIRECTORIES@
  RMDir "$INSTDIR"
  ${GetParameters} $0
  ClearErrors
  ${GetOptions} $0 "/UPGRADE" $1
  ${If} ${Errors}
    ; A real uninstall, not the first step of an upgrade.
    ReadRegStr $1 HKCU "${PRODUCT_KEY}" "StartMenuShortcut"
    ${If} $1 == "${SHORTCUT}"
      Delete "${SHORTCUT}"
    ${EndIf}
    ReadRegStr $1 HKCU "${PRODUCT_KEY}" "InstallLocation"
    ${If} $1 == $INSTDIR
      DeleteRegKey HKCU "${PRODUCT_KEY}"
    ${EndIf}
  ${EndIf}
  ${If} ${FileExists} "$INSTDIR\*.*"
    DetailPrint "Files that Setup did not install were left in $INSTDIR"
  ${EndIf}
SectionEnd
