# nova_folder_file_regexes(<out> <folder>...)
# Regexes that match "a file directly inside one of these folders" for file(GET_RUNTIME_DEPENDENCIES)
# filters. CMake may lowercase names for matching and may report either separator, so each folder
# is matched in its own case and in lowercase, with [/\] for every separator.
function(nova_folder_file_regexes out)
  set(result "")
  foreach(dir IN LISTS ARGN)
    file(TO_CMAKE_PATH "${dir}" dir)
    string(REGEX REPLACE "/+$" "" dir "${dir}")
    string(TOLOWER "${dir}" dir_lower)
    foreach(variant IN ITEMS "${dir}" "${dir_lower}")
      string(REGEX REPLACE "([][+.*()^$?|\\\\])" "\\\\\\1" rx "${variant}")
      string(REPLACE "/" "[/\\\\]" rx "${rx}")
      list(APPEND result "^${rx}[/\\\\][^/\\\\]+$")
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES result)
  set(${out} "${result}" PARENT_SCOPE)
endfunction()

